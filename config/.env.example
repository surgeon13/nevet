# Copy this file to .env (in the repo root) and edit before installing.
# .env is git-ignored — your real secrets never get committed.

# Key for the /api/stats endpoint (other devices posting game stats).
WEBAPP_API_KEY=changeme-api-key

# Signs the login cookie. Leave as is and a random key is generated and
# kept next to the database automatically; set your own long random
# string only if you want to control it.
WEBAPP_SECRET=change-this-too-please

# true  = anyone who can reach the web app can create an account
#         (like joining a game; the site is only on your network/Tailscale)
# false = only logged-in players can add new accounts
WEBAPP_OPEN_SIGNUP=true
